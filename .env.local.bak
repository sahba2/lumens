NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=zA/QB0drg99qGiIZVK79XtlqcI+dxYZ3/3c/z1sucuA=

# ============================================================================
# LUMENS · SMTP (welcome / confirmation e-mail on sign-up)
# ----------------------------------------------------------------------------
# Fill these in to enable outgoing mail. While SMTP_HOST is empty the sign-up
# flow keeps working exactly as before and the welcome e-mail is skipped.
#
# Gmail  : smtp.gmail.com | 587 | SMTP_SECURE=false | app password as SMTP_PASS
# Outlook: smtp.office365.com | 587 | SMTP_SECURE=false
# SMTPS  : <host> | 465 | SMTP_SECURE=true
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LUMENS <no-reply@lumens.archi>"
MAIL_REPLY_TO=""

# Only for local/self-signed SMTP servers. Never disable in production.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# ============================================================================
# LUMENS · SMS (welcome SMS + passwordless / account-recovery codes)
# ----------------------------------------------------------------------------
# Leave SMS_PROVIDER empty to disable outgoing SMS: sign-up and password login
# keep working. "console" prints messages in the dev terminal (local testing).
#
# Kavenegar   : SMS_PROVIDER=kavenegar   | SMS_API_KEY=<api-key>
# Melipayamak : SMS_PROVIDER=melipayamak | SMS_USERNAME=<user> SMS_PASSWORD=<pass>
# Optional    : SMS_SENDER=<line>, SMS_OTP_TEMPLATE=<verify template name>
# ============================================================================
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=
SMS_OTP_TEMPLATE=
SMS_BASE_URL=

# Optional HMAC key for one-time codes (falls back to NEXTAUTH_SECRET).
# OTP_SECRET=


