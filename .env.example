# ============================================================================
# LUMENS · Supabase environment template
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env.local`
# 2. Fill the values from Supabase Dashboard -> Project Settings -> API
# 3. `.env.local` is git-ignored, never commit real keys.
# ============================================================================

# Public project URL, safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Public anon key (RLS protected). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Server-only key. Used by scripts / admin routes / storage uploads.
# NEVER prefix it with NEXT_PUBLIC_ and never import `lib/supabase-admin.ts`
# from a Client Component.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Absolute site origin used to build auth redirect URLs (email confirmation,
# magic link, password recovery). Use the production domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================================
# LUMENS · NextAuth (credentials login + local JSON user store)
# ----------------------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
# In development a built-in fallback is used, so the form works out of the box;
# in production `NEXTAUTH_SECRET` is mandatory.
# ============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-SECRET"

# Optional: folder that keeps the local JSON database (defaults to ./.data).
# LUMENS_DATA_DIR=".data"

# ============================================================================
# LUMENS · SMTP (welcome / confirmation e-mail on sign-up)
# ----------------------------------------------------------------------------
# Used by `lib/mail.ts` (nodemailer). When `SMTP_HOST` is empty the sign-up
# route skips the e-mail and keeps working, so this block is optional.
# Any SMTP relay works: Gmail app password, Mailgun, SendGrid, SES, ...
# ============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" for STARTTLS (587/25).
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"

# Envelope sender shown in the inbox, e.g. "LUMENS <no-reply@lumens.archi>".
MAIL_FROM="LUMENS <no-reply@lumens.archi>"
# Optional Reply-To address (leave empty to omit the header).
MAIL_REPLY_TO=""

# Only for local mail catchers with self-signed certificates.
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# ============================================================================
# LUMENS · SMS (welcome SMS + passwordless / account-recovery codes)
# ----------------------------------------------------------------------------
# Used by `lib/sms.ts`. When no provider is configured the sign-up route skips
# the SMS and the "ورود با کد پیامکی" tab reports that SMS is not configured.
#
# Supported providers
#   kavenegar   : SMS_PROVIDER="kavenegar"   + SMS_API_KEY
#                 optional SMS_OTP_TEMPLATE -> uses verify/lookup (recommended)
#   melipayamak : SMS_PROVIDER="melipayamak" + SMS_USERNAME + SMS_PASSWORD
#   console     : SMS_PROVIDER="console"     -> prints messages to the terminal
# ============================================================================
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_SENDER=""
SMS_OTP_TEMPLATE=""
# Optional REST base override (self-hosted gateways / tests).
SMS_BASE_URL=""
# Optional request timeout in milliseconds (default 8000).
# SMS_TIMEOUT_MS="8000"

# HMAC key used to hash one-time codes. Falls back to NEXTAUTH_SECRET.
# Generate with:  openssl rand -base64 32
# OTP_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-SECRET"

# ============================================================================
# LUMENS · AI Architecture Engine - image rendering (Mode 2)
# ----------------------------------------------------------------------------
# Server-only. NEVER prefix these with NEXT_PUBLIC_ and never import
# `lib/image-provider.ts` from a Client Component.
#
#   IMAGE_GEN_PROVIDER = openai | fal | replicate | huggingface | demo | none
#
#     openai       any OpenAI-compatible  POST {IMAGE_GEN_BASE_URL}/images/generations
#                  (OpenAI, Together AI, AvalAI, DeepInfra, Fireworks, ...)
#     fal          fal.run synchronous endpoint, default model fal-ai/flux/dev
#     replicate    api.replicate.com predictions, default flux-schnell
#     huggingface  router.huggingface.co/hf-inference, default FLUX.1-schnell
#     demo         curated Unsplash architectural renders (default when no key)
#     none         disable image rendering completely (text phases still work)
#
# With NO key configured the engine automatically answers with a real,
# high-quality architectural photo from the Unsplash CDN, so the sheet looks
# finished while the studio is still wiring its provider. Set a key (or
# IMAGE_GEN_PROVIDER) to switch to real generation - nothing else to change.
# ============================================================================
IMAGE_GEN_API_KEY=""
# Optional: inferred from the key/base URL when empty.
IMAGE_GEN_PROVIDER=""
# Optional: e.g. https://api.together.xyz/v1 | https://api.avalai.ir/v1
#           fal:       https://fal.run          (default)
#           replicate: https://api.replicate.com/v1
#           huggingface: https://router.huggingface.co/hf-inference/models
IMAGE_GEN_BASE_URL=""
# Optional model override, e.g.:
#   fal:          fal-ai/flux/dev | fal-ai/flux/schnell
#   huggingface: black-forest-labs/FLUX.1-schnell | stabilityai/stable-diffusion-xl-base-1.0
#   replicate:   black-forest-labs/flux-schnell
IMAGE_GEN_MODEL=""
# Optional pixel size override for OpenAI-compatible providers (e.g. 1024x1024).
IMAGE_GEN_SIZE=""
# Optional request timeout in milliseconds (default 60000).
# IMAGE_GEN_TIMEOUT_MS="60000"
# Optional response format for OpenAI-compatible hosts ("url" or "b64_json").
# IMAGE_GEN_RESPONSE_FORMAT="url"

# Sample renders used before a real key exists (comma separated, https only).
# Defaults to a curated Unsplash architecture set.
# IMAGE_SAMPLE_RENDERS=""

# Free image renders granted to every registered account (default 3).
RENDER_FREE_CREDITS="3"

# Extra hosts allowed by /api/render/proxy (comma separated, https only).
# Provider CDNs (fal.media, replicate.delivery, ...) are allowed by default.
# IMAGE_PROXY_ALLOWED_HOSTS=""



