# ============================================================================
# LUMENS · Supabase environment template
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env.local`
# 2. Fill the values from Supabase Dashboard -> Project Settings -> API
# 3. `.env.local` is git-ignored, never commit real keys.
# ============================================================================

# Public project URL, safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Public anon key (RLS protected). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Server-only key. Used by scripts / admin routes / storage uploads.
# NEVER prefix it with NEXT_PUBLIC_ and never import `lib/supabase-admin.ts`
# from a Client Component.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Absolute site origin used to build auth redirect URLs (email confirmation,
# magic link, password recovery). Use the production domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================================
# LUMENS · NextAuth (credentials login + local JSON user store)
# ----------------------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
# In development a built-in fallback is used, so the form works out of the box;
# in production `NEXTAUTH_SECRET` is mandatory.
# ============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-SECRET"

# Optional: folder that keeps the local JSON database (defaults to ./.data).
# LUMENS_DATA_DIR=".data"

# ============================================================================
# LUMENS · SMTP (welcome / confirmation e-mail on sign-up)
# ----------------------------------------------------------------------------
# Used by `lib/mail.ts` (nodemailer). When `SMTP_HOST` is empty the sign-up
# route skips the e-mail and keeps working, so this block is optional.
# Any SMTP relay works: Gmail app password, Mailgun, SendGrid, SES, ...
# ============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" for STARTTLS (587/25).
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"

# Envelope sender shown in the inbox, e.g. "LUMENS <no-reply@lumens.archi>".
MAIL_FROM="LUMENS <no-reply@lumens.archi>"
# Optional Reply-To address (leave empty to omit the header).
MAIL_REPLY_TO=""

# Only for local mail catchers with self-signed certificates.
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# ============================================================================
# LUMENS · SMS (welcome SMS + passwordless / account-recovery codes)
# ----------------------------------------------------------------------------
# Used by `lib/sms.ts`. When no provider is configured the sign-up route skips
# the SMS and the "ورود با کد پیامکی" tab reports that SMS is not configured.
#
# Supported providers
#   kavenegar   : SMS_PROVIDER="kavenegar"   + SMS_API_KEY
#                 optional SMS_OTP_TEMPLATE -> uses verify/lookup (recommended)
#   melipayamak : SMS_PROVIDER="melipayamak" + SMS_USERNAME + SMS_PASSWORD
#   console     : SMS_PROVIDER="console"     -> prints messages to the terminal
# ============================================================================
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_SENDER=""
SMS_OTP_TEMPLATE=""
# Optional REST base override (self-hosted gateways / tests).
SMS_BASE_URL=""
# Optional request timeout in milliseconds (default 8000).
# SMS_TIMEOUT_MS="8000"

# HMAC key used to hash one-time codes. Falls back to NEXTAUTH_SECRET.
# Generate with:  openssl rand -base64 32
# OTP_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-SECRET"


